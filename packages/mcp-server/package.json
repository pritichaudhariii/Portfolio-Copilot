{
  "name": "@portfolio-copilot/mcp-server",
  "version": "1.0.0",
  "description": "Custom MCP server exposing portfolio tools, resources and data sources for Portfolio Copilot.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "portfolio-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts --http",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js --http",
    "start:stdio": "node dist/index.js --stdio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
