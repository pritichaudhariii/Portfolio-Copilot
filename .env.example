# ---- Web app (apps/web) ----
# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: model used by the agent loop
ANTHROPIC_MODEL=claude-sonnet-5-5
# URL of the MCP server's Streamable HTTP endpoint
MCP_SERVER_URL=http://localhost:3001/mcp

# ---- MCP server (packages/mcp-server) ----
# Port for the Streamable HTTP transport
PORT=3001
# Optional: if set, both the server and the web app use it as a bearer token
MCP_AUTH_TOKEN=
# Optional: where the server persists runtime data (defaults to packages/mcp-server/data/runtime)
# DATA_DIR=/data
